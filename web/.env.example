# Leave empty for the website when it is served from the same origin as the API
# (Netlify, or the backend's SERVE_WEB mode) and for local development (the Vite proxy handles it).
#
# REQUIRED for the Android app, and for a website hosted on a different domain than the API:
# the public URL of the deployed backend, with no trailing slash.
VITE_API_BASE_URL=
