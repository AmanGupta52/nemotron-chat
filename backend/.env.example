# ---- AI providers (at least one) ----
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
OPENROUTER_API_KEY=our_openrouter_api_key_here

# ---- Database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nemotron-workbench?retryWrites=true&w=majority
# Optional: database name if it is not part of the URI.
# MONGODB_DB=nemotron-workbench
# Optional: use if you see "querySrv ECONNREFUSED" (local DNS refuses SRV lookups).
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- File storage (Cloudinary) ----
# Images and every other file type go to Cloudinary; MongoDB keeps only the link.
# Use ONE of these styles (Cloudinary dashboard > API Keys):
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# This app's own folder + tag inside the shared Cloudinary account (default shown).
CLOUDINARY_FOLDER=nemotron-workbench
# Max upload size in MB (Cloudinary free plan: 10).
# UPLOAD_MAX_MB=10

# ---- Auth ----
# At least 32 random bytes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# ---- Verification e-mails (EmailJS) ----
EMAILJS_SERVICE_ID=REPLACE_WITH_YOUR_SERVICE_ID
EMAILJS_TEMPLATE_ID=REPLACE_WITH_YOUR_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=REPLACE_WITH_YOUR_PUBLIC_KEY
# Required if "Use Private Key" is enabled in EmailJS > Account > Security.
# EMAILJS_PRIVATE_KEY=
# Also enable "Allow EmailJS API for non-browser applications" in the same Security page.

# ---- Web / mobile origins allowed to call this API (comma-separated) ----
# The mobile app (https://localhost, capacitor://localhost) is allowed by default.
# Add your website origin if it is hosted on a different domain than the API, and local dev origins.
ALLOWED_ORIGINS=http://localhost:5173

# ---- Standalone server only ----
PORT=8787
# Set to true when running behind a reverse proxy (Render, Railway, Fly, nginx) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
# Serve ../web/dist from this server as well (single deployable).
SERVE_WEB=false

# ---- Optional OpenRouter request attribution ----
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Nemotron Workbench
